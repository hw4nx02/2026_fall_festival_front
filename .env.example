# API 서버 주소 (api/client.js에서 사용)
VITE_API_BASE_URL=http://localhost:8000
# 관리자용 API 주소 — 관리자 앱(npm run dev:admin)이 사용. 백엔드가 Host(admin.*)로 관리자 API를 구분해서 로컬은 admin.localhost
# (배포에서는 비워둔다: 관리자 빌드가 admin.dgufesta.com에서 열리므로 같은 도메인 상대경로로 요청)
VITE_ADMIN_API_BASE_URL=http://admin.localhost:8000

# 운영 환경에서는 각 앱과 API가 같은 Origin을 사용한다.
# VITE_API_BASE_URL=https://dgufesta.com
# VITE_ADMIN_API_BASE_URL=https://admin.dgufesta.com


# 카카오 OAuth REST API 키 (클라이언트 시크릿이 아님)
VITE_KAKAO_REST_API_KEY=
# 배포 환경에서는 https://dgufesta.com/ 으로 설정
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/

# 관리자 페이지 라우트 가드용 — 실제 인증은 백엔드에서 관리자 키를 검증하고
# 그 결과로 받은 토큰을 useAdminAuthStore에 저장하는 방식으로 처리 (프론트에 키를 하드코딩하지 않음)
